<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>CyrillicFontFix</AssemblyName>
    <RootNamespace>CyrillicFontFix</RootNamespace>
    <Version>0.1.0</Version>
    <GameDir Condition="'$(GameDir)' == '' and '$(MR_PREPPER_DIR)' != ''">$(MR_PREPPER_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\MrPrepper</GameDir>
    <GameManaged>$(GameDir)\MrPrepper_Data\Managed</GameManaged>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <PluginFolderName>AcTePuKc Cyrillic Font Fix</PluginFolderName>
    <DistDir>$(MSBuildProjectDirectory)\..\..\dist\$(PluginFolderName)</DistDir>
    <GamePluginsDir>$(GameDir)\BepInEx\plugins\$(PluginFolderName)</GamePluginsDir>
    <FontBundle>$(MSBuildProjectDirectory)\..\..\.work\font-tests\mrprepper-roboto-bold-cyrillic</FontBundle>
    <ConfigTemplate>$(MSBuildProjectDirectory)\config\actepukc.mrprepper.cyrillicfontfix.cfg</ConfigTemplate>
  </PropertyGroup>

  <Import Project="..\..\User.targets" Condition="Exists('..\..\User.targets')" />

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')" Text="BepInEx.dll not found. Install BepInEx 5.x in GameDir first." />
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found. Check GameDir." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(GameManaged)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TextMeshPro-2017.3-Runtime"><HintPath>$(GameManaged)\TextMeshPro-2017.3-Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="StageMod" AfterTargets="Build">
    <MakeDir Directories="$(DistDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)" />
    <MakeDir Directories="$(DistDir)\config" />
    <Copy SourceFiles="$(ConfigTemplate)" DestinationFolder="$(DistDir)\config" />
    <Copy Condition="Exists('$(FontBundle)')" SourceFiles="$(FontBundle)" DestinationFolder="$(DistDir)" />
    <MakeDir Directories="$(GamePluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePluginsDir)" />
    <MakeDir Directories="$(GameDir)\BepInEx\config" />
    <Copy SourceFiles="$(ConfigTemplate)" DestinationFolder="$(GameDir)\BepInEx\config" />
    <Copy Condition="Exists('$(FontBundle)')" SourceFiles="$(FontBundle)" DestinationFolder="$(GamePluginsDir)" />
  </Target>
</Project>
